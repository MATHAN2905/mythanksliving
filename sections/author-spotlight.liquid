{{ 'author-spotlight.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sec = section.settings
  assign author_img = sec.author_image

  assign discount_percent = sec.discount_percent | default: 40
  assign min_quantity = sec.min_quantity | default: 12
  assign badge_text = sec.badge_text
  if badge_text == blank
    assign badge_text = discount_percent | append: '% OFF'
  endif

  assign bulk_heading = sec.bulk_heading
  if bulk_heading == blank
    assign bulk_heading = 'Save ' | append: discount_percent | append: '% on Bulk Orders'
  endif

  assign bulk_subtitle = sec.bulk_subtitle
  if bulk_subtitle == blank
    assign bulk_subtitle = 'Buy ' | append: min_quantity | append: ' or more books and automatically receive ' | append: discount_percent | append: '% off your order.'
  endif
-%}

<div class="author-spotlight"
  id="about-the-author"
  style="
    --as-bg: {{ sec.section_bg }};
    --as-text: {{ sec.text_color }};
    --as-muted: {{ sec.muted_text_color }};
    --as-accent: {{ sec.accent_color }};
    --as-panel-bg: {{ sec.panel_bg }};
    --as-panel-text: {{ sec.panel_text_color }};
    --as-panel-muted: {{ sec.panel_muted_color }};
    --as-radius: {{ sec.corner_radius }}px;
    --as-pt: {{ sec.padding_top }}px;
    --as-pb: {{ sec.padding_bottom }}px;
  ">
  <div class="author-spotlight__wrap">
    <div class="author-spotlight__grid {% if sec.reverse_layout %}author-spotlight__grid--reverse{% endif %}">

      {%- comment -%} LEFT / AUTHOR CARD {%- endcomment -%}
      <div class="as-author">
        <div class="as-author__media">
          {%- if author_img != blank -%}
            <img
              src="{{ author_img | image_url: width: 600 }}"
              srcset="{{ author_img | image_url: width: 300 }} 300w, {{ author_img | image_url: width: 600 }} 600w, {{ author_img | image_url: width: 900 }} 900w"
              sizes="(min-width: 750px) 260px, 45vw"
              alt="{{ author_img.alt | default: sec.author_name | escape }}"
              width="{{ author_img.width }}"
              height="{{ author_img.height }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="as-author__placeholder">{{ 'image' | placeholder_svg_tag: 'as-placeholder-svg' }}</div>
          {%- endif -%}
        </div>

        <div class="as-author__content">
          {%- if sec.eyebrow != blank -%}
            <p class="as-eyebrow">{{ sec.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if sec.author_name != blank -%}
            <h2 class="as-author__name">{{ sec.author_name | escape }}</h2>
          {%- endif -%}

          {%- if sec.bio != blank -%}
            <div class="as-author__bio">{{ sec.bio }}</div>
          {%- endif -%}

          {%- if sec.extra_text != blank -%}
            <div class="as-author__extra">{{ sec.extra_text }}</div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div class="as-social">
              {%- for block in section.blocks -%}
                {%- if block.type == 'social_link' and block.settings.url != blank -%}
                  <a
                    class="as-social__link"
                    href="{{ block.settings.url }}"
                    aria-label="{{ block.settings.platform | escape }}"
                    target="_blank"
                    rel="noopener"
                    {{ block.shopify_attributes }}
                  >
                    {% comment %} {%- case block.settings.platform -%}
                      {%- when 'facebook' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
                      {%- when 'instagram' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.22.6 1.77 1.15.55.55.9 1.11 1.15 1.77.25.64.42 1.37.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.22 1.15-1.77A4.9 4.9 0 0 1 5.45.53c.64-.25 1.37-.42 2.43-.47C8.94 2.01 9.28 2 12 2zm0 1.8c-2.67 0-2.99.01-4.04.06-.87.04-1.34.18-1.66.31-.42.16-.72.35-1.03.66-.31.31-.5.61-.66 1.03-.13.32-.27.79-.31 1.66C4.24 8.71 4.23 9.03 4.23 11.7v.6c0 2.67.01 2.99.06 4.04.04.87.18 1.34.31 1.66.16.42.35.72.66 1.03.31.31.61.5 1.03.66.32.13.79.27 1.66.31 1.05.05 1.37.06 4.04.06h.6c2.67 0 2.99-.01 4.04-.06.87-.04 1.34-.18 1.66-.31.42-.16.72-.35 1.03-.66.31-.31.5-.61.66-1.03.13-.32.27-.79.31-1.66.05-1.05.06-1.37.06-4.04v-.6c0-2.67-.01-2.99-.06-4.04-.04-.87-.18-1.34-.31-1.66a2.77 2.77 0 0 0-.66-1.03 2.77 2.77 0 0 0-1.03-.66c-.32-.13-.79-.27-1.66-.31-1.05-.05-1.37-.06-4.04-.06zm0 3.7a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zm0 1.8a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4zm4.68-1.99a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1z"/></svg>
                      {%- when 'x' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.5h3.3l-7.2 8.23L23 21.5h-6.62l-5.2-6.8-5.94 6.8H1.94l7.7-8.8L1 2.5h6.78l4.7 6.22 5.76-6.22zm-1.16 17h1.83L7.05 4.4H5.08l12 15.1z"/></svg>
                      {%- when 'youtube' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.11-2.13C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.39.57A3 3 0 0 0 .5 6.2 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.8 3 3 0 0 0 2.11 2.13C4.5 20.5 12 20.5 12 20.5s7.5 0 9.39-.57a3 3 0 0 0 2.11-2.13A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.8zM9.6 15.6V8.4l6.4 3.6-6.4 3.6z"/></svg>
                      {%- when 'podcast' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a5 5 0 0 1 5 5v5a5 5 0 0 1-10 0V7a5 5 0 0 1 5-5zm-7 9a1 1 0 0 1 2 0 5 5 0 0 0 10 0 1 1 0 0 1 2 0 7 7 0 0 1-6 6.93V21h2a1 1 0 0 1 0 2H9a1 1 0 0 1 0-2h2v-3.07A7 7 0 0 1 5 11z"/></svg>
                      {%- when 'tiktok' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 2h-3.2v13.4a3 3 0 1 1-2.4-2.94V9.2a6.2 6.2 0 1 0 5.6 6.17V8.85a7.6 7.6 0 0 0 4.4 1.4V7.05a4.4 4.4 0 0 1-4.4-4.4V2z"/></svg>
                      {%- when 'pinterest' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.64 19.32c-.05-.83-.09-2.1.02-3 .1-.82.66-5.24.66-5.24s-.17-.34-.17-.83c0-.79.46-1.38 1.03-1.38.48 0 .72.36.72.8 0 .49-.31 1.22-.47 1.9-.13.56.28 1.03.84 1.03 1 0 1.77-1.06 1.77-2.58 0-1.35-.97-2.3-2.36-2.3-1.6 0-2.55 1.2-2.55 2.45 0 .48.19.99.42 1.27a.17.17 0 0 1 .04.16c-.05.19-.15.6-.17.68-.03.11-.09.14-.2.08-.75-.35-1.22-1.44-1.22-2.32 0-1.89 1.37-3.63 3.96-3.63 2.08 0 3.7 1.48 3.7 3.46 0 2.07-1.3 3.73-3.11 3.73-.61 0-1.18-.32-1.38-.69l-.37 1.44c-.14.53-.51 1.2-.76 1.6.57.18 1.18.27 1.81.27A10 10 0 0 0 12 2z"/></svg>
                      {%- when 'email' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13zm2 .4v.2l8 6 8-6v-.2H4zm16 2.3-7.4 5.55a1 1 0 0 1-1.2 0L4 8.2v10.3h16V8.2z"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
                    {%- endcase -%} {% endcomment %}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} RIGHT / BULK SAVINGS PANEL {%- endcomment -%}
      {%- if sec.show_panel -%}
        <div class="as-panel as-panel--bulk-offer">
          {%- if sec.show_badge -%}
            <span class="as-bulk-offer__badge">{{ badge_text | escape }}</span>
          {%- endif -%}

          <div class="as-bulk-offer__copy">
            {%- if sec.bulk_eyebrow != blank -%}
              <p class="as-bulk-offer__eyebrow">{{ sec.bulk_eyebrow | escape }}</p>
            {%- endif -%}

            {%- if bulk_heading != blank -%}
              <h3 class="as-bulk-offer__heading">{{ bulk_heading | escape }}</h3>
            {%- endif -%}

            {%- if bulk_subtitle != blank -%}
              <p class="as-bulk-offer__subtitle">{{ bulk_subtitle | escape }}</p>
            {%- endif -%}

            {%- if sec.bulk_button_label != blank -%}
              <a class="as-bulk-offer__button" href="{{ sec.bulk_button_url | default: '#' }}" {% render 'landing-link-target', url: sec.bulk_button_url %}>
                {{ sec.bulk_button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Author Spotlight",
  "tag": "section",
  "class": "shopify-section-author-spotlight",
  "settings": [
    {
      "type": "header",
      "content": "Author card"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "MEET THE AUTHOR"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author photo"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "Author Name"
    },
    {
      "type": "richtext",
      "id": "bio",
      "label": "Bio",
      "default": "<p>Write a short biography introducing the author, their background, and their work.</p>"
    },
    {
      "type": "richtext",
      "id": "extra_text",
      "label": "Additional text (optional)",
      "info": "Use for a secondary line, e.g. family details."
    },
    {
      "type": "header",
      "content": "Bulk savings panel"
    },
    {
      "type": "checkbox",
      "id": "show_panel",
      "label": "Show bulk savings panel",
      "default": true
    },
    {
      "type": "range",
      "id": "discount_percent",
      "label": "Discount percentage",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "min_quantity",
      "label": "Minimum books",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show discount badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "OFF",
      "info": "Leave blank to use discount percentage."
    },
    {
      "type": "text",
      "id": "bulk_eyebrow",
      "label": "Panel eyebrow",
      "default": "Bulk savings"
    },
    {
      "type": "text",
      "id": "bulk_heading",
      "label": "Panel heading",
      "default": "Order 12+ books and save"
    },
    {
      "type": "textarea",
      "id": "bulk_subtitle",
      "label": "Panel text",
      "default": "Your 40% discount applies automatically at checkout — mix any titles."
    },
    {
      "type": "text",
      "id": "bulk_button_label",
      "label": "Button label",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "bulk_button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse column order",
      "default": false
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colors — section"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading / text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color (bio, eyebrow)",
      "default": "#5b5b5b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (arrow, icons hover)",
      "default": "#c9a24b"
    },
    {
      "type": "header",
      "content": "Colors — bulk savings panel"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "panel_text_color",
      "label": "Panel heading color",
      "default": "#0f3156"
    },
    {
      "type": "color",
      "id": "panel_muted_color",
      "label": "Panel body text color",
      "default": "#4d6d86"
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            { "value": "facebook", "label": "Facebook" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "x", "label": "X (Twitter)" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "podcast", "label": "Podcast" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "pinterest", "label": "Pinterest" },
            { "value": "email", "label": "Email" }
          ],
          "default": "facebook"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Author Spotlight",
      "blocks": [
        { "type": "social_link", "settings": { "platform": "facebook" } },
        { "type": "social_link", "settings": { "platform": "instagram" } },
        { "type": "social_link", "settings": { "platform": "x" } },
        { "type": "social_link", "settings": { "platform": "youtube" } },
        { "type": "social_link", "settings": { "platform": "podcast" } }
      ]
    }
  ]
}
{% endschema %}
