{{ 'landing-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-testimonials.js' | asset_url }}" defer></script>

{% liquid
  assign section_classes = 'landing-testimonials color-custom-' | append: section.id

  if section.settings.enable_section == false
    assign section_classes = section_classes | append: ' landing-testimonials--hidden'
  endif
  if section.settings.show_on_desktop == false
    assign section_classes = section_classes | append: ' landing-testimonials--desktop-hidden'
  endif
  if section.settings.show_on_tablet == false
    assign section_classes = section_classes | append: ' landing-testimonials--tablet-hidden'
  endif
  if section.settings.show_on_mobile == false
    assign section_classes = section_classes | append: ' landing-testimonials--mobile-hidden'
  endif

  assign overlay_color = section.settings.overlay_color
  if section.settings.background_image == blank
    assign overlay_color = 'transparent'
  endif

  assign card_shadow = 'none'
  if section.settings.enable_card_shadow
    assign card_shadow = '0 12px 22px rgb(8 36 61 / 0.08)'
  endif

  assign show_controls = false
  if section.blocks.size > 1
    assign show_controls = true
  endif
%}

{% render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id %}

<landing-testimonials
  id="reviews"
  class="{{ section_classes }}"
  data-animate="{{ section.settings.enable_animation }}"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-interval="{{ section.settings.autoplay_interval_ms }}"
  data-desktop-cols="{{ section.settings.columns_desktop }}"
  data-tablet-cols="{{ section.settings.columns_tablet }}"
  data-mobile-cols="{{ section.settings.columns_mobile }}"
  style="
    --lts-bg: {{ section.settings.background_color }};
    --lts-bg-image: {% if section.settings.background_image != blank %}url('{{ section.settings.background_image | image_url: width: 2600 }}'){% else %}none{% endif %};
    --lts-overlay: {{ overlay_color }};
    --lts-overlay-opacity: {{ section.settings.overlay_opacity }};
    --lts-text: {{ section.settings.text_color }};
    --lts-heading: {{ section.settings.heading_color }};
    --lts-meta: {{ section.settings.meta_color }};
    --lts-accent: {{ section.settings.accent_color }};
    --lts-star: {{ section.settings.star_color }};
    --lts-container-width: {{ section.settings.container_width }}px;
    --lts-content-width: {{ section.settings.content_width }}px;
    --lts-head-align: {{ section.settings.heading_align }};
    --lts-cols-desktop: {{ section.settings.columns_desktop }};
    --lts-cols-tablet: {{ section.settings.columns_tablet }};
    --lts-cols-mobile: {{ section.settings.columns_mobile }};
    --lts-gap: {{ section.settings.grid_gap }}px;
    --lts-card-height: {{ section.settings.card_min_height }}px;
    --lts-card-radius: {{ section.settings.card_radius }}px;
    --lts-card-bg: {{ section.settings.card_background }};
    --lts-border-rgb: {{ section.settings.card_border_color.rgb }};
    --lts-border-opacity: {{ section.settings.card_border_opacity }};
    --lts-shadow: {{ card_shadow }};
    --lts-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --lts-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --lts-heading-weight: {{ section.settings.heading_weight }};
    --lts-body-size-desktop: {{ section.settings.body_size_desktop }}px;
    --lts-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --lts-quote-size: {{ section.settings.quote_size }}px;
    --lts-avatar-size: {{ section.settings.avatar_size }}px;
    --lts-space-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --lts-space-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --lts-space-top-tablet: {{ section.settings.padding_top_tablet }}px;
    --lts-space-bottom-tablet: {{ section.settings.padding_bottom_tablet }}px;
    --lts-space-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --lts-space-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="landing-testimonials__bg" aria-hidden="true"></div>
  <div class="landing-testimonials__overlay" aria-hidden="true"></div>

  <div class="landing-testimonials__inner">
    <div class="landing-testimonials__head" data-reveal="up">
      {% if section.settings.eyebrow != blank %}
        <p class="landing-testimonials__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="landing-testimonials__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.intro != blank %}
        <div class="landing-testimonials__intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </div>

    <div class="landing-testimonials__viewport" data-reveal="up">
      <div class="landing-testimonials__track" data-track>
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' and block.settings.quote != blank %}
            <article class="landing-testimonials__card" data-slide {{ block.shopify_attributes }}>
              {% comment %} {% liquid
                assign rating = block.settings.rating | plus: 0
                if rating < 1
                  assign rating = 1
                endif
                if rating > 5
                  assign rating = 5
                endif
              %} {% endcomment %}

              {% comment %} <p class="landing-testimonials__rating" aria-label="{{ rating }} out of 5 stars">
                {% for i in (1..5) %}
                  <svg class="landing-testimonials__star" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    {% if i <= rating %}
                      <path d="m10 1.8 2.36 4.78 5.27.77-3.82 3.72.9 5.25L10 13.86 5.3 16.32l.9-5.25L2.4 7.35l5.26-.77L10 1.8Z" fill="currentColor"/>
                    {% else %}
                      <path d="m10 1.8 2.36 4.78 5.27.77-3.82 3.72.9 5.25L10 13.86 5.3 16.32l.9-5.25L2.4 7.35l5.26-.77L10 1.8Z" stroke="currentColor" stroke-width="1.2"/>
                    {% endif %}
                  </svg>
                {% endfor %}
              </p> {% endcomment %}

              <blockquote class="landing-testimonials__quote">{{ block.settings.quote }}</blockquote>

              <div class="landing-testimonials__author-row">
                <div class="landing-testimonials__avatar" aria-hidden="true">
                  {% if block.settings.avatar != blank %}
                    {{ block.settings.avatar | image_url: width: 220 | image_tag: widths: '60,90,120,160,220', sizes: '46px', loading: 'lazy', alt: block.settings.name }}
                  {% else %}
                    <div class="landing-testimonials__avatar-fallback"></div>
                  {% endif %}
                </div>

                <div>
                  {% if block.settings.name != blank %}
                    <p class="landing-testimonials__author-name">{{ block.settings.name }}</p>
                  {% endif %}
                  {% if block.settings.meta != blank %}
                    <p class="landing-testimonials__author-meta">{{ block.settings.meta }}</p>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if show_controls %}
      {% liquid
        assign slides_count = section.blocks.size
        assign desktop_cols = section.settings.columns_desktop | plus: 0
        assign pages = slides_count | divided_by: desktop_cols
        assign rem = slides_count | modulo: desktop_cols
        if rem > 0
          assign pages = pages | plus: 1
        endif
        if pages < 1
          assign pages = 1
        endif
      %}

      <div class="landing-testimonials__footer" data-reveal="up">
        <div class="landing-testimonials__dots">
          {% for i in (1..pages) %}
            <button type="button" class="landing-testimonials__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Go to testimonials page {{ i }}"></button>
          {% endfor %}
        </div>

        <div class="landing-testimonials__controls">
          <button type="button" class="landing-testimonials__control" data-prev aria-label="Previous testimonials" disabled>
            <svg viewBox="0 0 24 24" fill="none"><path d="m14.5 5-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="landing-testimonials__control" data-next aria-label="Next testimonials">
            <svg viewBox="0 0 24 24" fill="none"><path d="m9.5 5 7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    {% endif %}
  </div>
</landing-testimonials>

{% schema %}
{
  "name": "Landing Testimonials",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "enable_section", "label": "Enable section", "default": true },
    { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop", "default": true },
    { "type": "checkbox", "id": "show_on_tablet", "label": "Show on tablet", "default": true },
    { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What readers are saying" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Testimonials" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Real voices from readers who found fresh gratitude and encouragement through this message.</p>" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },

    { "type": "header", "content": "Slider" },
    { "type": "select", "id": "columns_desktop", "label": "Desktop cards", "options": [{ "value": "2", "label": "2 cards" }, { "value": "3", "label": "3 cards" }, { "value": "4", "label": "4 cards" }], "default": "3" },
    { "type": "select", "id": "columns_tablet", "label": "Tablet cards", "options": [{ "value": "1", "label": "1 card" }, { "value": "2", "label": "2 cards" }, { "value": "3", "label": "3 cards" }], "default": "2" },
    { "type": "select", "id": "columns_mobile", "label": "Mobile cards", "options": [{ "value": "1", "label": "1 card" }, { "value": "2", "label": "2 cards" }], "default": "1" },
    { "type": "checkbox", "id": "enable_autoplay", "label": "Enable autoplay", "default": false },
    { "type": "range", "id": "autoplay_interval_ms", "label": "Autoplay interval", "min": 2000, "max": 9000, "step": 500, "unit": "ms", "default": 5000 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "container_width", "label": "Container width", "min": 960, "max": 1760, "step": 20, "unit": "px", "default": 1320 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 860, "max": 1720, "step": 20, "unit": "px", "default": 1240 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "card_min_height", "label": "Card minimum height", "min": 220, "max": 520, "step": 4, "unit": "px", "default": 300 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 34, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "avatar_size", "label": "Avatar size", "min": 28, "max": 90, "step": 2, "unit": "px", "default": 46 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#f3f8fc" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#0f315600" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 0 },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffffe6" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#adc6dc" },
    { "type": "range", "id": "card_border_opacity", "label": "Card border opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 80 },
    { "type": "checkbox", "id": "enable_card_shadow", "label": "Enable card shadow", "default": true },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#123d5d" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#355977" },
    { "type": "color", "id": "meta_color", "label": "Meta text", "default": "#5f7f9a" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#6f9ec5" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#f0b426" },

    { "type": "header", "content": "Typography and animation" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 20, "max": 44, "step": 2, "unit": "px", "default": 30 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [{ "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }], "default": "700" },
    { "type": "range", "id": "body_size_desktop", "label": "Body size desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "body_size_mobile", "label": "Body size mobile", "min": 11, "max": 17, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "quote_size", "label": "Quote text size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable reveal animation", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_desktop", "label": "Desktop top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Desktop bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top_tablet", "label": "Tablet top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_tablet", "label": "Tablet bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Thanks Living helped me build a daily rhythm of gratitude that changed how I see every part of life." },
        { "type": "text", "id": "name", "label": "Name", "default": "Sarah M." },
        { "type": "text", "id": "meta", "label": "Meta", "default": "Small group leader" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "avatar", "label": "Avatar image" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Landing Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Thanks Living helped me build a daily rhythm of gratitude that changed how I see every part of life.", "name": "Sarah M.", "meta": "Small group leader", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "Our family read this together and the reflection prompts gave us meaningful conversations every week.", "name": "Jared T.", "meta": "Father of three", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "Practical, biblical, and encouraging. I keep returning to these lessons in every season.", "name": "Angela R.", "meta": "Teacher", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
