{{ 'landing-author-section.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-author-section.js' | asset_url }}" defer></script>

{% liquid
  assign section_classes = 'landing-author-section color-custom-' | append: section.id

  if section.settings.enable_section == false
    assign section_classes = section_classes | append: ' landing-author-section--hidden'
  endif
  if section.settings.show_on_desktop == false
    assign section_classes = section_classes | append: ' landing-author-section--desktop-hidden'
  endif
  if section.settings.show_on_tablet == false
    assign section_classes = section_classes | append: ' landing-author-section--tablet-hidden'
  endif
  if section.settings.show_on_mobile == false
    assign section_classes = section_classes | append: ' landing-author-section--mobile-hidden'
  endif

  if section.settings.portrait_position == 'right'
    assign section_classes = section_classes | append: ' landing-author-section--portrait-right'
  endif

  assign overlay_color = section.settings.overlay_color
  if section.settings.background_image == blank
    assign overlay_color = 'transparent'
  endif

  assign panel_shadow = 'none'
  if section.settings.enable_panel_shadow
    assign panel_shadow = '0 14px 26px rgb(9 39 66 / 0.1)'
  endif
%}

{% render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id %}

<landing-author-section
  class="{{ section_classes }}"
  data-animate="{{ section.settings.enable_animation }}"
  data-float="{{ section.settings.enable_portrait_float }}"
  style="
    --las-bg: {{ section.settings.background_color }};
    --las-bg-image: {% if section.settings.background_image != blank %}url('{{ section.settings.background_image | image_url: width: 2600 }}'){% else %}none{% endif %};
    --las-overlay: {{ overlay_color }};
    --las-overlay-opacity: {{ section.settings.overlay_opacity }};
    --las-panel-bg: {{ section.settings.panel_background }};
    --las-border-rgb: {{ section.settings.panel_border_color.rgb }};
    --las-border-opacity: {{ section.settings.panel_border_opacity }};
    --las-shadow: {{ panel_shadow }};
    --las-text: {{ section.settings.text_color }};
    --las-heading: {{ section.settings.heading_color }};
    --las-subheading: {{ section.settings.subheading_color }};
    --las-quote: {{ section.settings.quote_color }};
    --las-accent: {{ section.settings.accent_color }};
    --las-container-width: {{ section.settings.container_width }}px;
    --las-content-width: {{ section.settings.content_width }}px;
    --las-portrait-width: {{ section.settings.portrait_width }}px;
    --las-portrait-radius: {{ section.settings.portrait_radius }}px;
    --las-panel-radius: {{ section.settings.panel_radius }}px;
    --las-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --las-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --las-heading-weight: {{ section.settings.heading_weight }};
    --las-body-size-desktop: {{ section.settings.body_size_desktop }}px;
    --las-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --las-quote-size: {{ section.settings.quote_size }}px;
    --las-signature-width: {{ section.settings.signature_width }}px;
    --las-button-bg: {{ section.settings.button_background }};
    --las-button-hover: {{ section.settings.button_background_hover }};
    --las-button-text: {{ section.settings.button_text_color }};
    --las-button-border: {{ section.settings.button_border_color }};
    --las-button-radius: {{ section.settings.button_radius }}px;
    --las-space-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --las-space-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --las-space-top-tablet: {{ section.settings.padding_top_tablet }}px;
    --las-space-bottom-tablet: {{ section.settings.padding_bottom_tablet }}px;
    --las-space-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --las-space-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="landing-author-section__bg" aria-hidden="true"></div>
  <div class="landing-author-section__overlay" aria-hidden="true"></div>

  <div class="landing-author-section__inner">
    <article class="landing-author-section__panel">
      <div class="landing-author-section__media" data-reveal="left">
        <div class="landing-author-section__portrait-wrap">
          {% if section.settings.author_image != blank %}
            {{ section.settings.author_image | image_url: width: 1600 | image_tag: widths: '280,420,560,760,960,1200,1600', sizes: '(max-width: 989px) 86vw, 34vw', loading: 'lazy', alt: section.settings.author_image_alt | default: section.settings.author_name }}
          {% else %}
            <div class="landing-author-section__portrait-fallback" aria-hidden="true"></div>
          {% endif %}

          {% if section.settings.badge_text != blank %}
            <span class="landing-author-section__badge">
              <span class="landing-author-section__badge-dot" aria-hidden="true"></span>
              {{ section.settings.badge_text }}
            </span>
          {% endif %}
        </div>
      </div>

      <div class="landing-author-section__content" data-reveal="right">
        {% if section.settings.eyebrow != blank %}
          <p class="landing-author-section__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="landing-author-section__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="landing-author-section__subheading">{{ section.settings.subheading }}</p>
        {% endif %}

        {% if section.settings.bio != blank %}
          <div class="landing-author-section__bio rte">{{ section.settings.bio }}</div>
        {% endif %}

        {% if section.settings.quote != blank %}
          <blockquote class="landing-author-section__quote">{{ section.settings.quote }}</blockquote>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="landing-author-section__highlights">
            {% for block in section.blocks %}
              {% if block.type == 'highlight' and block.settings.text != blank %}
                <span class="landing-author-section__pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.signature_image != blank or section.settings.author_name != blank %}
          <div class="landing-author-section__signature">
            {% if section.settings.signature_image != blank %}
              {{ section.settings.signature_image | image_url: width: 720 | image_tag: widths: '120,180,240,320,420,560,720', sizes: '180px', loading: 'lazy', alt: section.settings.signature_alt | default: section.settings.author_name }}
            {% endif %}
            {% if section.settings.author_name != blank %}
              <p class="landing-author-section__signature-name">{{ section.settings.author_name }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a class="landing-author-section__cta" href="{{ section.settings.button_url | default: '#' }}" {% render 'landing-link-target', url: section.settings.button_url %}>{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
    </article>
  </div>
</landing-author-section>

{% schema %}
{
  "name": "Landing Author Section",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "enable_section", "label": "Enable section", "default": true },
    { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop", "default": true },
    { "type": "checkbox", "id": "show_on_tablet", "label": "Show on tablet", "default": true },
    { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meet the author" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The heart behind Thanks Living" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "A personal journey of gratitude, scripture, and daily faith." },
    { "type": "richtext", "id": "bio", "label": "Bio", "default": "<p>Stu has spent decades helping people rediscover a life rooted in thankfulness. Through personal stories, biblical reflection, and practical encouragement, this book invites readers to live with joy in every season.</p>" },
    { "type": "textarea", "id": "quote", "label": "Author quote", "default": "My prayer is that this message helps you choose gratitude every day, no matter the season." },
    { "type": "text", "id": "author_name", "label": "Author name", "default": "Stu Epperson" },
    { "type": "text", "id": "badge_text", "label": "Portrait badge", "default": "Author & Speaker" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more" },
    { "type": "url", "id": "button_url", "label": "Button link" },

    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "author_image", "label": "Author image" },
    { "type": "text", "id": "author_image_alt", "label": "Author image alt", "default": "Portrait of the author" },
    { "type": "image_picker", "id": "signature_image", "label": "Signature image" },
    { "type": "text", "id": "signature_alt", "label": "Signature image alt", "default": "Author signature" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "portrait_position", "label": "Portrait position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "container_width", "label": "Container width", "min": 960, "max": 1760, "step": 20, "unit": "px", "default": 1320 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 860, "max": 1720, "step": 20, "unit": "px", "default": 1220 },
    { "type": "range", "id": "portrait_width", "label": "Portrait width", "min": 240, "max": 760, "step": 8, "unit": "px", "default": 424 },
    { "type": "range", "id": "portrait_radius", "label": "Portrait radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "panel_radius", "label": "Panel radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#f7fbff" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#0f315600" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 0 },
    { "type": "color", "id": "panel_background", "label": "Panel background", "default": "#ffffffe0" },
    { "type": "color", "id": "panel_border_color", "label": "Panel border", "default": "#b7cde0" },
    { "type": "range", "id": "panel_border_opacity", "label": "Panel border opacity", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 80 },
    { "type": "checkbox", "id": "enable_panel_shadow", "label": "Enable panel shadow", "default": true },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#355977" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#123d5d" },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#416482" },
    { "type": "color", "id": "quote_color", "label": "Quote color", "default": "#274b69" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#7aafdb" },

    { "type": "header", "content": "Typography and style" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 20, "max": 44, "step": 2, "unit": "px", "default": 30 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [{ "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }], "default": "700" },
    { "type": "range", "id": "body_size_desktop", "label": "Body size desktop", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "body_size_mobile", "label": "Body size mobile", "min": 11, "max": 17, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "quote_size", "label": "Quote text size", "min": 14, "max": 30, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "signature_width", "label": "Signature width", "min": 100, "max": 360, "step": 4, "unit": "px", "default": 180 },
    { "type": "checkbox", "id": "enable_portrait_float", "label": "Enable portrait float effect", "default": true },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable reveal animation", "default": true },

    { "type": "header", "content": "Button" },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#123d5d" },
    { "type": "color", "id": "button_background_hover", "label": "Button hover background", "default": "#0f3150" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "color", "id": "button_border_color", "label": "Button border color", "default": "#123d5d" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_desktop", "label": "Desktop top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Desktop bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_tablet", "label": "Tablet top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_tablet", "label": "Tablet bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Nationally known speaker" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Landing Author Section",
      "blocks": [
        { "type": "highlight", "settings": { "text": "Nationally known speaker" } },
        { "type": "highlight", "settings": { "text": "Radio broadcaster" } },
        { "type": "highlight", "settings": { "text": "Faith-centered storyteller" } }
      ]
    }
  ]
}
{% endschema %}
