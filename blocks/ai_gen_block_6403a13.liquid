<script>
  (() => {
    const root = document.querySelector('.ai-buy-product-{{ ai_gen_id }}');
    if (!root) return;

    root.querySelectorAll('[data-quantity-selector]').forEach((selector) => {
      const input = selector.querySelector('input[name="quantity"]');
      const minus = selector.querySelector('[data-quantity-minus]');
      const plus = selector.querySelector('[data-quantity-plus]');
      if (!input || !minus || !plus) return;

      const clampQuantity = (value) => Math.max(1, Number.parseInt(value, 10) || 1);

      minus.addEventListener('click', () => {
        input.value = clampQuantity(Number.parseInt(input.value, 10) - 1);
      });

      plus.addEventListener('click', () => {
        input.value = clampQuantity(Number.parseInt(input.value, 10) + 1);
      });

      input.addEventListener('change', () => {
        input.value = clampQuantity(input.value);
      });
    });
  })();
</script>

