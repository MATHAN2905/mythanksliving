{% doc %}
  Thanks Living Bracelet hero + purchase section matching brand mockups.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign featured_product = all_products['thanks-living-bracelet'] %}

{% liquid
  if block.settings.background_image != blank
    assign background_image_url = block.settings.background_image | image_url: width: 2400
  else
    assign background_image_url = 'bracelet-section-background.jpg' | asset_url
  endif

  if block.settings.background_image_mobile != blank
    assign background_image_mobile_url = block.settings.background_image_mobile | image_url: width: 1200
  else
    assign background_image_mobile_url = 'bracelet-section-background-mobile.jpg' | asset_url
  endif

  assign qr_target_url = block.settings.qr_target_url
  if qr_target_url == blank
    assign qr_target_url = shop.url
  endif
  assign encoded_qr_target = qr_target_url | url_encode
  assign generated_qr_url = 'https://api.qrserver.com/v1/create-qr-code/?size=600x600&ecc=H&data=' | append: encoded_qr_target

  assign qr_scan_text = block.settings.qr_scan_text | default: 'SCAN FOR A DAILY GRATITUDE VERSE'
  if qr_scan_text contains 'GRATITUDE VERSE'
    assign qr_scan_line_1 = qr_scan_text | replace: 'GRATITUDE VERSE', '' | strip
    assign qr_scan_line_2 = 'GRATITUDE VERSE'
  else
    assign qr_scan_line_1 = qr_scan_text
    assign qr_scan_line_2 = ''
  endif
%}

{% style %}
  .ai-buy-product-{{ ai_gen_id }} {
    --tl-navy: {{ block.settings.navy_color }};
    --tl-yellow: {{ block.settings.accent_color }};
    --tl-teal: {{ block.settings.teal_color }};
    --tl-icon-bg: rgba(186, 224, 235, 0.72);
    --tl-section-bg: #f6fbff;
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-buy-product-{{ ai_gen_id }}__scene {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    isolation: isolate;
    background: var(--tl-section-bg);
  }

  .ai-buy-product-{{ ai_gen_id }}__scene::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('{{ background_image_url }}');
    background-size: cover;
    background-position: {{ block.settings.background_position }};
    background-repeat: no-repeat;
    opacity: calc({{ block.settings.background_outer_opacity | default: 35 }} / 100);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 18%);
    mask-image: linear-gradient(180deg, transparent 0%, black 18%);
  }

  @media screen and (max-width: 999px) {
    .ai-buy-product-{{ ai_gen_id }}__scene {
      overflow: visible;
    }
  }

  .ai-buy-product-{{ ai_gen_id }}__background {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: 1;
    width: 100%;
    max-width: {{ block.settings.background_max_width }}px;
    background-image: url('{{ background_image_url }}');
    background-size: cover;
    background-position: {{ block.settings.background_position }};
    background-repeat: no-repeat;
    transform: translateX(-50%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 16%);
    mask-image: linear-gradient(180deg, transparent 0%, black 16%);
  }

  .ai-buy-product-{{ ai_gen_id }}__background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--tl-section-bg) 0%,
      rgb(246 251 255 / 0.45) 10%,
      rgb(246 251 255 / 0) 20%,
      rgb(255 255 255 / 0) 45%,
      rgb(255 255 255 / 0.18) 100%
    );
  }

  .ai-buy-product-{{ ai_gen_id }}__layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(280px, 1.05fr) minmax(400px, 1.85fr) minmax(300px, 340px);
    gap: clamp(20px, 3vw, 40px);
    align-items: end;
    max-width: 1440px;
    min-height: 620px;
    margin: 0 auto;
    padding: clamp(32px, 4.5vw, 56px) clamp(24px, 4vw, 48px) clamp(28px, 4vw, 52px);
  }

  .ai-buy-product-{{ ai_gen_id }}__hero-stage {
    display: contents;
  }

  .ai-buy-product-{{ ai_gen_id }}__hero {
    display: flex;
    flex-direction: column;
    gap: 18px;
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    padding-top: 8px;
    max-width: 420px;
  }

  .ai-buy-product-{{ ai_gen_id }}__headline {
    margin: 0;
    max-width: 11em;
    color: var(--tl-navy);
    font-family: var(--font-brand-title, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(36px, 4.2vw, 54px);
    line-height: 1.06;
    font-weight: 700;
  }

  .ai-buy-product-{{ ai_gen_id }}__headline-break {
    display: inline;
  }

  .ai-buy-product-{{ ai_gen_id }}__subheadline {
    margin: 0;
    max-width: 38ch;
    color: var(--tl-navy);
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.6;
    opacity: 0.88;
  }

  .ai-buy-product-{{ ai_gen_id }}__features-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 10px;
  }

  .ai-buy-product-{{ ai_gen_id }}__feature {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .ai-buy-product-{{ ai_gen_id }}__feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    color: var(--tl-navy);
    background: var(--tl-icon-bg);
    border: 1.5px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 0 1px rgba(18, 46, 77, 0.08);
  }

  .ai-buy-product-{{ ai_gen_id }}__feature-icon svg {
    width: 24px;
    height: 24px;
  }

  .ai-buy-product-{{ ai_gen_id }}__feature-title {
    margin: 0 0 4px;
    color: var(--tl-navy);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-buy-product-{{ ai_gen_id }}__feature-text {
    margin: 0;
    color: var(--tl-navy);
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.78;
  }

  .ai-buy-product-{{ ai_gen_id }}__visual {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(8px, 1.2vw, 14px);
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    min-height: 100%;
    margin-bottom: clamp(28px, 4vw, 48px);
    padding-bottom: 0;
    overflow: visible;
  }

  .ai-buy-product-{{ ai_gen_id }}__product-image {
    flex: 0 1 auto;
    width: 100%;
    max-width: clamp(380px, 42vw, 520px);
    filter: drop-shadow(0 16px 24px rgba(5, 29, 66, 0.14));
  }

  .ai-buy-product-{{ ai_gen_id }}__product-image img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    transform: scale(1.06);
    transform-origin: bottom center;
  }

  .ai-buy-product-{{ ai_gen_id }}__buy-aside {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    align-self: center;
    width: 100%;
    max-width: 320px;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-card {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 0 0 clamp(196px, 15vw, 220px);
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    align-self: flex-end;
    width: clamp(196px, 15vw, 220px);
    height: auto;
    min-height: 0;
    margin-bottom: clamp(16px, 2.2vw, 28px);
    padding: 17px 12px 14px;
    border-radius: 16px 16px 14px 14px;
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.14) 0%, transparent 52%),
      linear-gradient(180deg, #47b8cf 0%, #38a8bf 28%, var(--tl-teal) 100%);
    box-shadow:
      0 10px 24px rgba(5, 29, 66, 0.18),
      0 2px 8px rgba(5, 29, 66, 0.1);
    color: #ffffff;
    text-align: center;
    isolation: isolate;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-card::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background-image: radial-gradient(rgba(255, 255, 255, 0.12) 0.6px, transparent 0.6px);
    background-size: 3px 3px;
    opacity: 0.28;
    pointer-events: none;
    content: '';
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-header,
  .ai-buy-product-{{ ai_gen_id }}__qr-divider,
  .ai-buy-product-{{ ai_gen_id }}__qr-code-stage,
  .ai-buy-product-{{ ai_gen_id }}__qr-scan {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-top: 2px;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-brand {
    margin: 0;
    color: #ffffff;
    font-family: {{ settings.type_heading_font.family }}, Georgia, serif;
    font-size: clamp(8px, 0.95vw, 11px);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-tagline {
    margin: 0;
    color: #062440;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-divider {
    display: flex;
    align-items: center;
    gap: 6px;
    width: min(100%, 118px);
    margin: 6px auto;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-divider-line {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.52);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-divider-dot {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--tl-yellow);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-code-stage {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: clamp(3px, 0.5vw, 6px);
    height: auto;
    margin: 0 auto;
    padding: 3px 0;
    min-height: 0;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(5px, 0.7vw, 7px);
    width: clamp(12px, 1.6vw, 18px);
    flex-shrink: 0;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--left {
    align-items: flex-end;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--right {
    align-items: flex-start;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-ray {
    display: block;
    height: clamp(2px, 0.28vw, 3px);
    border-radius: 999px;
    background: var(--tl-yellow);
    box-shadow: 0 0 0 0.5px rgba(255, 255, 255, 0.08);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--left .ai-buy-product-{{ ai_gen_id }}__qr-ray {
    transform-origin: right center;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--right .ai-buy-product-{{ ai_gen_id }}__qr-ray {
    transform-origin: left center;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--left .ai-buy-product-{{ ai_gen_id }}__qr-ray:nth-child(1) {
    width: clamp(10px, 1.5vw, 14px);
    transform: rotate(28deg);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--left .ai-buy-product-{{ ai_gen_id }}__qr-ray:nth-child(2) {
    width: clamp(12px, 1.8vw, 18px);
    transform: rotate(0deg);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--left .ai-buy-product-{{ ai_gen_id }}__qr-ray:nth-child(3) {
    width: clamp(10px, 1.5vw, 14px);
    transform: rotate(-28deg);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--right .ai-buy-product-{{ ai_gen_id }}__qr-ray:nth-child(1) {
    width: clamp(10px, 1.5vw, 14px);
    transform: rotate(-28deg);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--right .ai-buy-product-{{ ai_gen_id }}__qr-ray:nth-child(2) {
    width: clamp(12px, 1.8vw, 18px);
    transform: rotate(0deg);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-rays--right .ai-buy-product-{{ ai_gen_id }}__qr-ray:nth-child(3) {
    width: clamp(10px, 1.5vw, 14px);
    transform: rotate(28deg);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-code-area {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: clamp(72px, 70%, 118px);
    aspect-ratio: 1;
    padding: clamp(4px, 0.6vw, 6px);
    border-radius: clamp(6px, 0.8vw, 10px);
    background: #ffffff;
    box-shadow: 0 1px 0 rgba(18, 46, 77, 0.06);
    overflow: hidden;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-code-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 4px;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-code-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(28px, 34%, 40px);
    height: clamp(28px, 34%, 40px);
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 0 3px #ffffff;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-code-logo svg {
    display: block;
    width: 78%;
    height: 78%;
    overflow: visible;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-code-logo svg path {
    fill: var(--tl-yellow);
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-scan {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 6px 0 0;
    color: #062440;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ai-buy-product-{{ ai_gen_id }}__qr-scan-line {
    display: block;
    color: #062440;
  }

  .ai-buy-product-{{ ai_gen_id }}__purchase-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex: 0 0 auto;
    width: 100%;
    max-width: 320px;
    padding: 30px 28px 26px;
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 20px;
    box-shadow: 0 14px 36px rgba(5, 29, 66, 0.1);
  }

  .ai-buy-product-{{ ai_gen_id }}__purchase-card .shopify-product-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-buy-product-{{ ai_gen_id }}__purchase-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-buy-product-{{ ai_gen_id }}__purchase-title {
    margin: 0;
    color: var(--tl-navy);
    font-family: var(--font-brand-title, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-size: clamp(24px, 2.1vw, 28px);
    font-style: normal;
    line-height: 1.08;
    font-weight: 700;
  }

  .ai-buy-product-{{ ai_gen_id }}__purchase-subtitle {
    margin: 0;
    color: rgba(18, 46, 77, 0.62);
    font-size: 13px;
    line-height: 1.4;
    font-weight: 500;
  }

  .ai-buy-product-{{ ai_gen_id }}__price-row {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .ai-buy-product-{{ ai_gen_id }}__price-group {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 10px;
  }

  .ai-buy-product-{{ ai_gen_id }}__price-current {
    font-size: clamp(28px, 2.8vw, 32px);
    font-weight: 700;
    line-height: 1;
    color: var(--tl-navy);
    letter-spacing: -0.01em;
  }

  .ai-buy-product-{{ ai_gen_id }}__price-compare {
    font-size: 15px;
    font-weight: 500;
    color: #9aa3ad;
    text-decoration: line-through;
  }

  .ai-buy-product-{{ ai_gen_id }}__save-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--tl-yellow);
    color: var(--tl-navy);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .ai-buy-product-{{ ai_gen_id }}__quantity-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
  }

  .ai-buy-product-{{ ai_gen_id }}__quantity-label {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--tl-navy);
  }

  .ai-buy-product-{{ ai_gen_id }}__quantity-selector {
    display: inline-flex;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid #c5dce9;
    border-radius: 10px;
    background: #ffffff;
  }

  .ai-buy-product-{{ ai_gen_id }}__qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    min-height: 36px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--tl-navy);
    font-size: 17px;
    line-height: 1;
    cursor: pointer;
  }

  .ai-buy-product-{{ ai_gen_id }}__qty-btn:hover {
    background: rgba(5, 29, 66, 0.05);
  }

  .ai-buy-product-{{ ai_gen_id }}__qty-input {
    width: 40px;
    min-height: 36px;
    padding: 0;
    border: 0;
    border-inline: 1px solid #d8dde5;
    background: transparent;
    color: var(--tl-navy);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .ai-buy-product-{{ ai_gen_id }}__qty-input::-webkit-outer-spin-button,
  .ai-buy-product-{{ ai_gen_id }}__qty-input::-webkit-inner-spin-button {
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
  }

  .ai-buy-product-{{ ai_gen_id }}__availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }

  .ai-buy-product-{{ ai_gen_id }}__availability::before {
    width: 7px;
    height: 7px;
    content: '';
    border-radius: 50%;
    background: currentColor;
  }

  .ai-buy-product-{{ ai_gen_id }}__availability--unavailable { color: #8a2f2f; }

  .ai-buy-product-{{ ai_gen_id }}__button {
    width: 100%;
    min-height: 50px;
    padding: 14px 20px;
    border: 0;
    border-radius: 12px;
    background: var(--tl-yellow);
    color: var(--tl-navy);
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .ai-buy-product-{{ ai_gen_id }}__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(255, 206, 77, 0.35);
  }

  .ai-buy-product-{{ ai_gen_id }}__button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
    box-shadow: none;
  }

  .ai-buy-product-{{ ai_gen_id }}__trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin-top: 2px;
    padding-top: 18px;
    border-top: 1px solid #e8ebf0;
  }

  .ai-buy-product-{{ ai_gen_id }}__trust-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding-inline: 6px;
    text-align: center;
  }

  .ai-buy-product-{{ ai_gen_id }}__trust-item:not(:last-child)::after {
    position: absolute;
    top: 6px;
    right: 0;
    width: 1px;
    height: calc(100% - 12px);
    content: '';
    background: #e8ebf0;
  }

  .ai-buy-product-{{ ai_gen_id }}__trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--tl-navy);
  }

  .ai-buy-product-{{ ai_gen_id }}__trust-icon svg {
    width: 22px;
    height: 22px;
  }

  .ai-buy-product-{{ ai_gen_id }}__trust-label {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--tl-navy);
  }

  .ai-buy-product-{{ ai_gen_id }}__features-bar {
    display: none;
  }

  @media screen and (min-width: 1000px) {
    .ai-buy-product-{{ ai_gen_id }}__headline {
      max-width: 12.5em;
    }

    .ai-buy-product-{{ ai_gen_id }}__visual {
      justify-content: center;
      padding-inline: clamp(8px, 1.5vw, 20px);
    }

    .ai-buy-product-{{ ai_gen_id }}__product-image {
      max-width: clamp(400px, 44vw, 520px);
    }

    .ai-buy-product-{{ ai_gen_id }}__product-image img {
      transform: scale(1.08);
    }

