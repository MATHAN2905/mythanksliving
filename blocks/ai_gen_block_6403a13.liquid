    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 10px clamp(10px, 1.4vw, 20px);
  }

  .ai-buy-product-{{ ai_gen_id }}__journey-step:not(:last-child)::after {
    position: absolute;
    top: 18%;
    right: 0;
    width: 1px;
    height: 64%;
    content: '';
    background: rgb(18 46 77 / 0.14);
  }

  .ai-buy-product-{{ ai_gen_id }}__journey-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    color: var(--tl-navy);
    background: #d7eef6;
  }

  .ai-buy-product-{{ ai_gen_id }}__journey-icon svg {
    width: 28px;
    height: 28px;
  }

  .ai-buy-product-{{ ai_gen_id }}__journey-copy {
    min-width: 0;
  }

  .ai-buy-product-{{ ai_gen_id }}__journey-title {
    margin: 0 0 4px;
    color: var(--tl-navy);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-buy-product-{{ ai_gen_id }}__journey-text {
    margin: 0;
    color: var(--tl-navy);
    font-size: 13px;
    line-height: 1.4;
    opacity: 0.78;
  }

  .ai-buy-product-{{ ai_gen_id }}__journey-verse {
    max-width: 720px;
    margin: clamp(18px, 3vw, 28px) auto 0;
    text-align: center;
  }

  .ai-buy-product-{{ ai_gen_id }}__journey-quote {
    margin: 0;
    color: var(--tl-navy);
    font-family: {{ settings.type_heading_font.family }}, Georgia, serif;
    font-size: clamp(22px, 2.6vw, 32px);
    font-style: italic;
    font-weight: 500;
    line-height: 1.3;
  }

  .ai-buy-product-{{ ai_gen_id }}__journey-cite {
    display: block;
    margin-top: 10px;
    color: var(--tl-navy);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
    opacity: 0.72;
  }

  @media screen and (max-width: 989px) {
    .ai-buy-product-{{ ai_gen_id }}__journey-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ai-buy-product-{{ ai_gen_id }}__journey-step:nth-child(2)::after {
      display: none;
    }

    .ai-buy-product-{{ ai_gen_id }}__journey-icon {
      width: 60px;
      height: 60px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-buy-product-{{ ai_gen_id }}__journey {
      display: none;
    }
  }
{% endstyle %}

