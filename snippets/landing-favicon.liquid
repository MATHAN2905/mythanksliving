{%- liquid
  if settings.favicon != blank
    assign favicon_href = settings.favicon | image_url: width: 32, height: 32
    assign apple_href = settings.favicon | image_url: width: 180, height: 180
  else
    assign favicon_href = 'thanks-living-logo-icon.png' | asset_url
    assign apple_href = 'thanks-living-logo-icon.png' | asset_url
  endif
-%}
<link
  rel="icon"
  type="image/png"
  href="{{ favicon_href }}"
  sizes="32x32"
>
<link
  rel="apple-touch-icon"
  href="{{ apple_href }}"
  sizes="180x180"
>
