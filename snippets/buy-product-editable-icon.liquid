{% doc %}
  Renders an uploaded Theme Editor icon, or the matching default SVG.

  @param {object} [image] - Image picker setting from the Buy product block
  @param {string} fallback - heart, flower, gift, book, truck, shield, phone, read, reflect
{% enddoc %}

{% if image != blank %}
  <img
    class="buy-product-icon-image"
    src="{{ image | image_url: width: 96, format: 'png' }}"
    srcset="{{ image | image_url: width: 48, format: 'png' }} 48w, {{ image | image_url: width: 72, format: 'png' }} 72w, {{ image | image_url: width: 96, format: 'png' }} 96w"
    sizes="28px"
    width="96"
    height="96"
    alt=""
    loading="lazy"
  >
{% else %}
  {% case fallback %}
    {% when 'heart' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20.5s-6.5-4.2-6.5-9.5A4.5 4.5 0 0 1 17 5.5L12 10l-5-4.5A4.5 4.5 0 0 1 5.5 11c0 5.3 6.5 9.5 6.5 9.5z"></path>
      </svg>
    {% when 'flower' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 20h10"></path>
        <path d="M12 20V10"></path>
        <path d="M12 10C12 10 8 8 8 4s8-2 8 2-4 6-4 6"></path>
      </svg>
    {% when 'gift' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 8h16v13H4z"></path>
        <path d="M12 8V5a2 2 0 0 0-2-2H8"></path>
        <path d="M12 8h4a2 2 0 0 0 2-2V3"></path>
      </svg>
    {% when 'book' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
    {% when 'truck' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 7h11v10H3z"></path>
        <path d="M14 10h3l3 3v4h-6z"></path>
        <circle cx="7.5" cy="17.5" r="1.5"></circle>
        <circle cx="17.5" cy="17.5" r="1.5"></circle>
      </svg>
    {% when 'shield' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l7 4v5c0 4.4-3 7.4-7 9-4-1.6-7-4.6-7-9V7z"></path>
        <path d="M9.5 12.5l1.8 1.8 3.5-3.8"></path>
      </svg>
    {% when 'phone' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="7" y="2.5" width="10" height="19" rx="2"></rect>
        <path d="M11 5h2"></path>
        <rect x="9.5" y="8" width="5" height="5" rx="0.5"></rect>
        <path d="M10.2 9.2h.8M12.2 9.2h1.1M10.2 10.7h1.1M12 10.7h1.3M10.2 12.2h.8M12.2 12.2h1.1"></path>
        <path d="M11 17.5h2"></path>
      </svg>
    {% when 'read' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 5.5c2.2-1 4.5-1.5 8-1.5s5.8.5 8 1.5v13c-2.2-1-4.5-1.5-8-1.5s-5.8.5-8 1.5z"></path>
        <path d="M12 4v13"></path>
      </svg>
    {% when 'reflect' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 10.5a7 7 0 1 1 3.2 5.9L6 18.5l.6-3A7 7 0 0 1 5 10.5z"></path>
        <circle cx="9.5" cy="10.5" r="0.7" fill="currentColor"></circle>
        <circle cx="12" cy="10.5" r="0.7" fill="currentColor"></circle>
        <circle cx="14.5" cy="10.5" r="0.7" fill="currentColor"></circle>
      </svg>
    {% when 'heart-fill' %}
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 20.2s-6.5-4.3-8.7-8a5 5 0 0 1 8.1-5.6l.6.7.6-.7a5 5 0 0 1 8.1 5.6c-2.2 3.7-8.7 8-8.7 8Z"/>
      </svg>
    {% else %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20.5s-6.5-4.2-6.5-9.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 6.5 4c0 5.3-6.5 9.5-6.5 9.5z"></path>
      </svg>
  {% endcase %}
{% endif %}
